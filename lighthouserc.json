{
  "ci": {
    "collect": {
      "startServerCommand": "npx -y serve -s build -l 9222",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://localhost:9222/",
        "http://localhost:9222/simulator",
        "http://localhost:9222/famous-people",
        "http://localhost:9222/conditions",
        "http://localhost:9222/faq",
        "http://localhost:9222/about",
        "http://localhost:9222/resources"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.8 }],
        "categories:performance": ["warn", { "minScore": 0.5 }]
      }
    }
  }
}
